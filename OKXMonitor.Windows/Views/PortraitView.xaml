<UserControl x:Class="OKXMonitor.Views.PortraitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OKXMonitor.Views.Controls"
             TextElement.Foreground="#DDD">
    <StackPanel Margin="12,8">
        <!-- Summary -->
        <Grid Margin="0,2,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="账户权益 (USD)" Foreground="#999" FontSize="13"/>
                <TextBlock x:Name="EquityText" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="MarginText" Foreground="#999" FontSize="13"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="未实现盈亏" Foreground="#999" FontSize="13" HorizontalAlignment="Right"/>
                <TextBlock x:Name="UplText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Realized PnL 3x5 grid -->
        <Border Background="#0AFFFFFF" CornerRadius="6" Padding="8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="已实现盈亏 (平仓)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                <Grid x:Name="PnlGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="盈利" FontSize="12" Foreground="#999" TextAlignment="Right"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="亏损" FontSize="12" Foreground="#999" TextAlignment="Right"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="手续费" FontSize="12" Foreground="#999" TextAlignment="Right"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="合计" FontSize="12" Foreground="#999" TextAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="FeeRateLine" FontSize="11" Foreground="#999" FontFamily="Consolas" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Positions -->
        <TextBlock Text="持仓" FontWeight="Bold" FontSize="14"/>
        <StackPanel x:Name="PositionsPanel" Margin="0,4,0,12"/>

        <!-- Pending orders carousel -->
        <TextBlock Text="挂单" FontWeight="Bold" FontSize="14"/>
        <ctl:Carousel x:Name="OrdersCarousel" RowsPerPage="2" Margin="0,4,0,12"/>

        <!-- Watchlist carousel -->
        <TextBlock Text="关注" FontWeight="Bold" FontSize="14"/>
        <ctl:Carousel x:Name="WatchCarousel" RowsPerPage="1" Margin="0,4,0,4"/>
    </StackPanel>
</UserControl>
